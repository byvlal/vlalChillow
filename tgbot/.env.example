# ── бот влалChillow ────────────────────────────────────────────────────────
# Скопируй этот файл в .env и заполни. .env в git не попадает.

# Какие серверы включены: local,remote (через запятую).
# Пусто — все, для которых задан ключ. Старый BOT_MODE=local/remote тоже понимается.
BOT_SERVERS=

# Токен от @BotFather. Обязателен.
TELEGRAM_BOT_TOKEN=

# Прокси только для Telegram. Панель ходит напрямую, без прокси.
# MargyCode: http://127.0.0.1:14883 (этот порт принимает и HTTP, и SOCKS5).
TELEGRAM_PROXY=http://127.0.0.1:14883

# ── локальный сервер ───────────────────────────────────────────────────────
LOCAL_API_URL=http://127.0.0.1:8080
# 64 hex-символа из auth/tgbot/password.txt. Новый выдаёт: tgbot resetkey
LOCAL_BOT_KEY=
# Адрес, который бот показывает игрокам в инструкции.
LOCAL_GAME_ADDRESS=127.0.0.1:7778
# Подпись в сообщениях (необязательно).
# LOCAL_LABEL=локальный сервер

# ── удалённый сервер ───────────────────────────────────────────────────────
REMOTE_SITE_URL=https://skam.su/vlalchillow
REMOTE_GAME_ADDRESS=212.164.115.37:7778
REMOTE_BOT_KEY=
# REMOTE_LABEL=Новосибирск

# ── общее ──────────────────────────────────────────────────────────────────
# База привязок Telegram → игрок. Каталог создастся сам, права 700/600.
BOT_DB_PATH=data/bot.db
BOT_TIMEZONE=Asia/Novosibirsk
BOT_API_TIMEOUT_SEC=20
