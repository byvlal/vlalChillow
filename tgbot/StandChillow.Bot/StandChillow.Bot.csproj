  <ItemGroup>
    <ProjectReference Include="../StandChillow.Bot.Contracts/StandChillow.Bot.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../.env.example" Link=".env.example"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
